{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/core/**",
              "components/editorial/**",
              "components/navigation/**",
              "ui_kits/portfolio/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Geist|Geist Mono))/i]",
        "message": "Font not provided by the design system. Available: Geist, Geist Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|variant|size|arrow|disabled|href|type|onClick|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: children, variant, size, arrow, disabled, href, type, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|ghost)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'ghost'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md)$/]",
        "message": "<Button> size must be one of 'sm' | 'md'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:button|submit)$/]",
        "message": "<Button> type must be one of 'button' | 'submit'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CaseStudyHero'] > JSXAttribute > JSXIdentifier[name!=/^(?:number|title|intro|facts|image|imageLabel|accent|key|ref|className|style|children)$/]",
        "message": "<CaseStudyHero> doesn't accept that prop. Declared props: number, title, intro, facts, image, imageLabel, accent."
      },
      {
        "selector": "JSXOpeningElement[name.name='ImageFrame'] > JSXAttribute > JSXIdentifier[name!=/^(?:src|alt|ratio|label|zoom|fit|background|style|key|ref|className|style|children)$/]",
        "message": "<ImageFrame> doesn't accept that prop. Declared props: src, alt, ratio, label, zoom, fit, background, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ImageFrame'] > JSXAttribute[name.name='fit'] > Literal[value!=/^(?:cover|contain)$/]",
        "message": "<ImageFrame> fit must be one of 'cover' | 'contain'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|placeholder|value|onChange|multiline|type|error|key|ref|className|style|children)$/]",
        "message": "<Input> doesn't accept that prop. Declared props: label, placeholder, value, onChange, multiline, type, error."
      },
      {
        "selector": "JSXOpeningElement[name.name='MetaLine'] > JSXAttribute > JSXIdentifier[name!=/^(?:items|accent|style|key|ref|className|style|children)$/]",
        "message": "<MetaLine> doesn't accept that prop. Declared props: items, accent, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='NextProject'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|number|href|onClick|key|ref|className|style|children)$/]",
        "message": "<NextProject> doesn't accept that prop. Declared props: title, number, href, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProjectEntry'] > JSXAttribute > JSXIdentifier[name!=/^(?:index|total|title|description|meta|image|imageLabel|ratio|layout|href|onClick|key|ref|className|style|children)$/]",
        "message": "<ProjectEntry> doesn't accept that prop. Declared props: index, total, title, description, meta, image, imageLabel, ratio, layout, href, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProjectEntry'] > JSXAttribute[name.name='layout'] > Literal[value!=/^(?:right|left)$/]",
        "message": "<ProjectEntry> layout must be one of 'right' | 'left'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProjectNumber'] > JSXAttribute > JSXIdentifier[name!=/^(?:index|total|style|key|ref|className|style|children)$/]",
        "message": "<ProjectNumber> doesn't accept that prop. Declared props: index, total, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Pullquote'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|cite|key|ref|className|style|children)$/]",
        "message": "<Pullquote> doesn't accept that prop. Declared props: children, cite."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionHeading'] > JSXAttribute > JSXIdentifier[name!=/^(?:number|label|title|intro|size|key|ref|className|style|children)$/]",
        "message": "<SectionHeading> doesn't accept that prop. Declared props: number, label, title, intro, size."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionHeading'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:display|h1|h2)$/]",
        "message": "<SectionHeading> size must be one of 'display' | 'h1' | 'h2'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SiteFooter'] > JSXAttribute > JSXIdentifier[name!=/^(?:statement|email|links|year|name|key|ref|className|style|children)$/]",
        "message": "<SiteFooter> doesn't accept that prop. Declared props: statement, email, links, year, name."
      },
      {
        "selector": "JSXOpeningElement[name.name='SiteHeader'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|role|links|active|onNavigate|key|ref|className|style|children)$/]",
        "message": "<SiteHeader> doesn't accept that prop. Declared props: name, role, links, active, onNavigate."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tag'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|selected|onClick|key|ref|className|style|children)$/]",
        "message": "<Tag> doesn't accept that prop. Declared props: children, selected, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='TextLink'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|href|arrow|size|muted|external|onClick|key|ref|className|style|children)$/]",
        "message": "<TextLink> doesn't accept that prop. Declared props: children, href, arrow, size, muted, external, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='TextLink'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:small|body|large)$/]",
        "message": "<TextLink> size must be one of 'small' | 'body' | 'large'."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
